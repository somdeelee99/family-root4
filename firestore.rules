rules_version = '2';

// =============================================================
// Family Root - Firestore Security Rules (Fixed Version)
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------- helpers -------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // ກວດສອບວ່າຜູ້ໃຊ້ມີ Document users/{uid} ແລ້ວ ຫຼື ບໍ່ (ປ້ອງກັນ Error ตอนสมัครสมาชิกใหม่)
    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return userExists() && myUser().role == 'admin';
    }

    function myFamilyId() {
      return userExists() && myUser().familyId != null
        ? myUser().familyId
        : '__no_family__';
    }

    function inSameFamily(familyId) {
      return userExists() && familyId != null && myFamilyId() == familyId;
    }

    function familyOwnerId(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data.ownerId;
    }

    function validRole(role) {
      return role in ['admin', 'member'];
    }

    // ------------------------- users --------------------------
    match /users/{uid} {
      // ອ່ານໄດ້ຖ້າເປັນຕົນເອງ ຫຼື ຢູ່ໃນຄອບຄົວດຽວກັນ (ກວດສອບ userExists ປ້ອງກັນ Null Pointer)
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        (userExists() && resource.data.familyId == myFamilyId())
      );

      // ສ້າງເອກະສານຂອງຕົນເອງ (ຕອນເຂົ້າລະບົບຄັ້ງທຳອິດ)
      allow create: if (
        (isSignedIn() &&
          request.auth.uid == uid &&
          request.resource.data.uid == uid &&
          validRole(request.resource.data.role) &&
          request.resource.data.familyId == null &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 100)
        ||
        // ບັນຊີສະມາຊິກທີ່ admin ສ້າງ
        (isAdmin() &&
          uid != request.auth.uid &&
          request.resource.data.uid == uid &&
          validRole(request.resource.data.role) &&
          request.resource.data.familyId == myFamilyId() &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 100)
      );

      // ອັບເດດໂປຣໄຟລ໌
      allow update: if (
        (isSignedIn() && request.auth.uid == uid && (
          (request.resource.data.role == resource.data.role &&
            request.resource.data.familyId == resource.data.familyId)
          || (request.resource.data.role == resource.data.role &&
            request.resource.data.familyId == null)
          || (request.resource.data.role == resource.data.role &&
            request.resource.data.familyId != null &&
            familyOwnerId(request.resource.data.familyId) == request.auth.uid)
          || (request.resource.data.role == 'member' &&
            request.resource.data.familyId != null &&
            familyOwnerId(request.resource.data.familyId) != request.auth.uid)
        ))
        ||
        (isAdmin() &&
          uid != request.auth.uid &&
          resource.data.familyId != null &&
          resource.data.familyId == myFamilyId() &&
          request.resource.data.familyId == resource.data.familyId &&
          validRole(request.resource.data.role))
      );

      allow delete: if isAdmin() &&
        uid != request.auth.uid &&
        resource.data.familyId != null &&
        resource.data.familyId == myFamilyId();
    }

    // ------------------------ families ------------------------
    match /families/{familyId} {
      allow get: if inSameFamily(familyId);
      allow list: if isSignedIn();

      allow create: if isAdmin() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.surname is string &&
        request.resource.data.surname.size() > 0 &&
        request.resource.data.surname.size() <= 100;

      allow update: if isAdmin() &&
        inSameFamily(familyId) &&
        request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if false;

      // ------------------- members -------------------
      match /members/{memberId} {
        allow read: if inSameFamily(familyId);
        allow create, update, delete: if isAdmin() && inSameFamily(familyId);
      }

      // ---------------- chats -------------------
      match /chats/{roomId} {
        function isParticipant() {
          return isSignedIn() && resource != null && request.auth.uid in resource.data.participants;
        }

        allow read: if inSameFamily(familyId) && (resource == null || isParticipant());

        allow create: if inSameFamily(familyId) &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() == 2 &&
          request.auth.uid in request.resource.data.participants;

        allow update: if inSameFamily(familyId) &&
          isParticipant() &&
          request.resource.data.participants == resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'lastSenderName', 'unread']);

        allow delete: if false;

        match /messages/{messageId} {
          function room() {
            return get(/databases/$(database)/documents/families/$(familyId)/chats/$(roomId)).data;
          }

          function isRoomParticipant() {
            return isSignedIn() && request.auth.uid in room().participants;
          }

          allow read: if inSameFamily(familyId) && isRoomParticipant();
          allow create: if inSameFamily(familyId) &&
            isRoomParticipant() &&
            request.resource.data.senderId == request.auth.uid;

          allow update: if inSameFamily(familyId) &&
            isRoomParticipant() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
            request.resource.data.readBy.hasAll(resource.data.readBy);

          allow delete: if false;
        }
      }

      // ---------------- activity log ----------------
      match /activity/{logId} {
        allow read: if inSameFamily(familyId);
        allow create: if inSameFamily(familyId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.action is string &&
          request.resource.data.action.size() <= 200;
        allow update, delete: if false;
      }
    }
  }
}